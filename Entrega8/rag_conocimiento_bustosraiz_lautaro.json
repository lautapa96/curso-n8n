    {
      "parameters": {
        "jsCode": "// Le damos nombre y extensión .ogg al binario descargado de Telegram,\n// tal como lo hizo la profe: sin esto, Groq/OpenAI no siempre reconocen\n// el formato del audio de las notas de voz.\nfor (const item of $input.all()) {\n  if (item.binary && item.binary.data) {\n    item.binary.data.fileName = \"nota_de_voz.ogg\";\n    item.binary.data.fileExtension = \"ogg\";\n  }\n}\nreturn $input.all();"
      },

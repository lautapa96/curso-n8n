    {
      "parameters": {
        "jsCode": "// Junta los chunks recuperados en un solo string para el Juez,\n// y arma el paquete de entrada del SUPERVISOR_Judge.\n// Defensivo: el nodo de Supabase puede devolver el texto del chunk bajo\n// distintos nombres según la versión (pageContent, document.pageContent,\n// text, content) — probamos todas las variantes conocidas.\nfunction extraerTexto(j) {\n  if (!j) return '';\n  return (\n    j.pageContent ||\n    j.text ||\n    j.content ||\n    (j.document && (j.document.pageContent || j.document.text)) ||\n    (j.metadata && j.metadata.pageContent) ||\n    ''\n  );\n}\n\nconst items = $input.all();\nconst contexto = items\n  .map(it => extraerTexto(it.json))\n  .filter(Boolean)\n  .join('\\n---\\n');\n\nconst chatInput = (() => {\n  try { return $('Preparar Entrada Telegram').item.json.chatInput } catch(e) {}\n  try { return $('Preparar Entrada Telegram (Voz)').item.json.chatInput } catch(e) {}\n  return '';\n})();\nconst session_id = (() => {\n  try { return $('Preparar Entrada Telegram').item.json.session_id } catch(e) {}\n  try { return $('Preparar Entrada Telegram (Voz)').item.json.session_id } catch(e) {}\n  return '';\n})();\nconst origen = (() => {\n  try { return $('Preparar Entrada Telegram').item.json.origen } catch(e) {}\n  try { return $('Preparar Entrada Telegram (Voz)').item.json.origen } catch(e) {}\n  return 'unknown';\n})();\nconst chat_id = (() => {\n  try { return $('Preparar Entrada Telegram').item.json.chat_id } catch(e) {}\n  try { return $('Preparar Entrada Telegram (Voz)').item.json.chat_id } catch(e) {}\n  return '';\n})();\n\n// Log de diagnóstico: si esto sigue vacío, mirá la consola del navegador\n// (F12) para ver qué forma tienen realmente los items de \"Recuperar Contexto\".\nif (!contexto) {\n  console.log('[QA] contexto vacío. Primer item crudo:', JSON.stringify(items[0] && items[0].json));\n}\n\nreturn [{\n  json: {\n    pregunta: chatInput,\n    contexto_recuperado: contexto,\n    respuesta_agente: $('AI Agent RAG (Electromundo)').item.json.output,\n    session_id, origen, chat_id,\n    contador_reintentos: 0\n  }\n}];\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1840,

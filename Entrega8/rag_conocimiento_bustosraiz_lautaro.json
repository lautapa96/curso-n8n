    {
      "parameters": {
        "jsCode": "// Compliance: el audio de voz del cliente (input) y el audio sintetizado (output)\n// solo existen en la memoria volátil de esta ejecución. Una vez enviada la nota de\n// voz de respuesta, se descarta explícitamente el binario del item para no dejarlo\n// flotando en el resto del flujo ni en logs de nodos posteriores.\nconst items = $input.all();\nfor (const item of items) {\n  item.binary = {};\n}\nreturn items;"
      },
